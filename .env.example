# AvantiQ Core and Azure OpenAI provider
PROVIDER=azure
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_PROVIDERS=["openrouter"]
LLM_ALLOWED_PROVIDERS=["azure","openrouter"]
LLM_PROVIDER_MODELS={"azure":"gpt-5.4-mini","openrouter":"openai/gpt-4.1-mini"}
LLM_ALLOWED_MODELS={"azure":["gpt-5.4-mini"],"openrouter":["openai/gpt-4.1-mini"]}
LLM_MODEL_CAPABILITIES={"azure:gpt-5.4-mini":["tools","json"],"openrouter:openai/gpt-4.1-mini":["tools","json"]}
LLM_PROVIDER_TIMEOUT_SECONDS=60

# Azure AI Content Safety is opt-in. Keep credentials in local .env or Azure
# Key Vault; never commit them. Thresholds use Azure's 0/2/4/6 scale.
CONTENT_SAFETY_ENABLED=false
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_API_VERSION=2024-09-01
CONTENT_SAFETY_INPUT_ENABLED=true
CONTENT_SAFETY_OUTPUT_ENABLED=true
CONTENT_SAFETY_PROMPT_SHIELDS_ENABLED=true
CONTENT_SAFETY_FAILURE_MODE=fail_closed
CONTENT_SAFETY_CATEGORY_THRESHOLDS={"hate":4,"sexual":4,"selfharm":4,"violence":4}
CONTENT_SAFETY_TIMEOUT_SECONDS=10
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TEMPERATURE=0.2
LIVE_LLM_ENABLED=false

# Dedicated Customer Support Langfuse project
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_URL=
# Explicit opt-in: sends complete prompts and model responses to this project.
LANGFUSE_CAPTURE_LLM_IO=false

# Runtime resilience (attempt counts include the first attempt)
ENVIRONMENT=development
MAX_RETRIES=2
REQUEST_TIMEOUT=90
RETRY_INITIAL_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=10
RETRY_BACKOFF_MULTIPLIER=2
LLM_MAX_ATTEMPTS=2
LLM_RETRY_INITIAL_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=10
LLM_RETRY_BACKOFF_MULTIPLIER=2
WORKFLOW_TIMEOUT_SECONDS=300
WORKFLOW_MAX_CONCURRENCY=4

# Per-process LLM protection
LLM_RATE_LIMIT_REQUESTS_PER_MINUTE=30
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=300

# SQLAlchemy connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Application
APP_NAME=Customer Support Assistant
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/customer_support

# Optional AvantiQ Admin Dashboard onboarding (fail-open)
AVANTIQ_ADMIN_CLIENT_ENABLED=false
AVANTIQ_ADMIN_CLIENT_BASE_URL=http://127.0.0.1:8010/admin/v1
AVANTIQ_ADMIN_CLIENT_TOKEN=
AVANTIQ_ADMIN_CLIENT_SERVICE_BASE_URL=http://127.0.0.1:8030
AVANTIQ_ADMIN_CLIENT_PUBLIC_BASE_URL=http://127.0.0.1:8030
AVANTIQ_ADMIN_CLIENT_ENVIRONMENT=local
AVANTIQ_ADMIN_CLIENT_TIMEOUT_SECONDS=5
AVANTIQ_ADMIN_CLIENT_HEARTBEAT_INTERVAL_SECONDS=60
