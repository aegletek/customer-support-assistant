# AvantiQ Core and Azure OpenAI provider
PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TEMPERATURE=0.2
LIVE_LLM_ENABLED=false

# Dedicated Customer Support Langfuse project
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_URL=

# Application
APP_NAME=Customer Support Assistant
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/customer_support

# Optional AvantiQ Admin Dashboard onboarding (fail-open)
AVANTIQ_ADMIN_CLIENT_ENABLED=false
AVANTIQ_ADMIN_CLIENT_BASE_URL=http://127.0.0.1:8010/admin/v1
AVANTIQ_ADMIN_CLIENT_TOKEN=
AVANTIQ_ADMIN_CLIENT_SERVICE_BASE_URL=http://127.0.0.1:8030
AVANTIQ_ADMIN_CLIENT_ENVIRONMENT=local
AVANTIQ_ADMIN_CLIENT_TIMEOUT_SECONDS=5
AVANTIQ_ADMIN_CLIENT_HEARTBEAT_INTERVAL_SECONDS=60
